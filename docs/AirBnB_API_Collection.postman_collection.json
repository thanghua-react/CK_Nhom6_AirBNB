  "item": [
    {
      "name": "01_Auth",
      "item": [
        {
          "name": "API_01 Signin - Happy Case",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Response contains token\", function () {",
                  "    pm.expect(jsonData.content).to.have.property(\"token\");",
                  "});",
                  "",
                  "// Save the token (and the user id) as collection variables so the next requests can reuse them",
                  "const token = jsonData.content && jsonData.content.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"token_airbnb\", token);",
                  "",
                  "    let userId = jsonData.content.user && jsonData.content.user.id;",
                  "    if (!userId) {",
                  "        // Fallback: the user id is stored in the JWT payload",
                  "        try {",
                  "            let payload = token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
                  "            while (payload.length % 4) { payload += \"=\"; }",
                  "            userId = JSON.parse(atob(payload)).id;",
                  "        } catch (e) {",
                  "            console.log(\"Cannot read user id from token: \" + e.message);",
                  "        }",
                  "    }",
                  "    if (userId) {",
                  "        pm.collectionVariables.set(\"user_id\", String(userId));",
                  "    }",
                  "}",
                  "pm.test(\"Response time is below 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "tokencybersoft",
                "value": "{{tokenCybersoft}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
