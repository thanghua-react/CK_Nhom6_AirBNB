        {
          "name": "API_16 Add Comment Without User Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Check-in = today + 30 days, check-out = today + 37 days (ISO date-time)",
                  "const day = 24 * 60 * 60 * 1000;",
                  "pm.collectionVariables.set(\"check_in\", new Date(Date.now() + 30 * day).toISOString());",
                  "pm.collectionVariables.set(\"check_out\", new Date(Date.now() + 37 * day).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Comment without user token must be rejected (400/401/403). 200 => BUG\", function () {",
