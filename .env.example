# Copy this file to .env and fill in real values. .env is git-ignored.
BASE_URL=https://demo5.cybersoft.edu.vn

# Valid account used by login / logout / booking / profile tests
LOGIN_EMAIL=
LOGIN_PASSWORD=

# Account that must NOT exist or must have a wrong password
LOGIN_INVALID_EMAIL=
LOGIN_INVALID_PASSWORD=

# Registration data. REGISTER_EXISTING_EMAIL must belong to an already registered
# user and must differ from LOGIN_EMAIL (it is also used for "update email" test).
REGISTER_NAME=
REGISTER_EXISTING_EMAIL=
REGISTER_PASSWORD=
REGISTER_PHONE=
# Format: "December 18, 2000"
REGISTER_BIRTHDAY=
# Text of the gender option, e.g. Male / Female
REGISTER_GENDER=
